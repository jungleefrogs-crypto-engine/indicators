        table.cell(screenerTable, 4, srow, f_di_text(scan8DiP, scan8DiM), text_color=f_di_color(scan8DiP, scan8DiM), bgcolor=f_row_bg(f_di_color(scan8DiP, scan8DiM)), text_size=tableValueSize)
