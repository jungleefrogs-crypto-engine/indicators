        table.cell(screenerTable, 4, srow, f_di_text(scan6DiP, scan6DiM), text_color=f_di_color(scan6DiP, scan6DiM), bgcolor=f_row_bg(f_di_color(scan6DiP, scan6DiM)), text_size=tableValueSize)
